{
  "version": 1,
  "project": "services-hub",
  "entities": [
    { "id": "core-farmer", "title": "فلاح (من نواة ثمرة)", "domain": "core", "external": "thamara:farmer", "description": "مرجع إلى حساب الفلاح في النواة. لا يُخزَّن هنا إلا المعرّف وموافقاته على مشاركة البيانات.", "fields": [ { "name": "core_id", "type": "ref", "required": true }, { "name": "consents", "type": "json", "required": true, "note": "لكل خدمة: مشاركة فردية أم مجمّعة" } ] },
    { "id": "core-farm", "title": "مزرعة (من النواة)", "domain": "core", "external": "thamara:farm", "fields": [ { "name": "core_id", "type": "ref", "required": true }, { "name": "governorate", "type": "string", "required": true }, { "name": "location", "type": "geo", "required": true } ] },
    { "id": "core-crop", "title": "محصول (من النواة)", "domain": "core", "external": "thamara:crop", "fields": [ { "name": "core_id", "type": "ref", "required": true }, { "name": "product", "type": "string", "required": true }, { "name": "season", "type": "string", "required": false } ] },
    { "id": "region", "title": "منطقة (محافظة/ناحية)", "domain": "core", "description": "التقسيم الجغرافي المعتمد لكل بيانات المحافظات.", "fields": [ { "name": "governorate", "type": "string", "required": true }, { "name": "district", "type": "string", "required": false }, { "name": "climate_zone", "type": "string", "required": false } ] },
    { "id": "provider", "title": "شركة/جهة مقدّمة", "domain": "partners", "description": "الشريك الذي يقدم خدمة مساندة: شركة بذور، أسمدة، مختبر، مركز إرشاد، ممول.", "fields": [ { "name": "name", "type": "string", "required": true }, { "name": "kind", "type": "enum", "required": true, "note": "inputs | lab | advisory | finance | insurance | logistics | other" }, { "name": "license", "type": "file", "required": false }, { "name": "contract_ref", "type": "string", "required": false, "note": "عقد مشاركة البيانات" }, { "name": "regions", "type": "json", "required": true }, { "name": "status", "type": "enum", "required": true } ], "screens": ["partner-onboarding", "partner-home"] },
    { "id": "provider-user", "title": "مستخدم لدى الشركة", "domain": "partners", "fields": [ { "name": "provider_id", "type": "ref", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "role", "type": "enum", "required": true, "note": "admin | agronomist | data-entry | sales" } ], "screens": ["partner-users"] },
    { "id": "service", "title": "خدمة", "domain": "catalog", "description": "تعريف الخدمة كما تظهر داخل تطبيق ثمرة.", "fields": [ { "name": "provider_id", "type": "ref", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "category", "type": "enum", "required": true, "note": "seeds | fertilizer | pesticide | soil-test | water-test | product-test | advisory | finance | insurance" }, { "name": "description", "type": "text", "required": true }, { "name": "input_schema", "type": "json", "required": true, "note": "ما يُطلب من الفلاح عند الطلب" }, { "name": "output_schema", "type": "json", "required": true, "note": "ما تعيده الخدمة للفلاح" }, { "name": "pricing", "type": "json", "required": false }, { "name": "regions", "type": "json", "required": true }, { "name": "status", "type": "enum", "required": true } ], "screens": ["partner-services", "farmer-services", "farmer-service-detail"] },
    { "id": "offering", "title": "عرض/منتج للخدمة", "domain": "catalog", "description": "صنف بذور أو سماد أو باقة تحليل بسعر وتوافر بحسب المنطقة.", "fields": [ { "name": "service_id", "type": "ref", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "spec", "type": "json", "required": false }, { "name": "price", "type": "money", "required": false }, { "name": "availability", "type": "json", "required": true, "note": "بحسب المحافظة" }, { "name": "suitable_products", "type": "json", "required": false, "note": "المحاصيل المناسبة" } ], "screens": ["partner-offerings", "farmer-service-detail"] },
    { "id": "service-request", "title": "طلب خدمة", "domain": "operations", "description": "طلب فلاح لخدمة: شراء مستلزم، حجز تحليل، طلب استشارة.", "fields": [ { "name": "service_id", "type": "ref", "required": true }, { "name": "farmer_id", "type": "ref", "required": true }, { "name": "farm_id", "type": "ref", "required": false }, { "name": "crop_id", "type": "ref", "required": false }, { "name": "input", "type": "json", "required": true }, { "name": "status", "type": "enum", "required": true, "note": "new | accepted | in-progress | delivered | closed | cancelled" }, { "name": "price", "type": "money", "required": false } ], "screens": ["farmer-service-request", "farmer-service-track", "partner-requests"] },
    { "id": "farm-report", "title": "تقرير/تحليل مرفوع", "domain": "data-up", "description": "ما يرفعه الفلاح: تحليل تربة أو مياه أو منتج، صور، ملاحظات بعد تجربة خدمة.", "fields": [ { "name": "farmer_id", "type": "ref", "required": true }, { "name": "farm_id", "type": "ref", "required": false }, { "name": "crop_id", "type": "ref", "required": false }, { "name": "kind", "type": "enum", "required": true, "note": "soil | water | product | photo | note" }, { "name": "file", "type": "file", "required": false }, { "name": "values", "type": "json", "required": false, "note": "قيم مستخرجة (pH، NPK…)" }, { "name": "shared_with", "type": "json", "required": true, "note": "الخدمات المسموح لها بالاطلاع" }, { "name": "date", "type": "date", "required": true } ], "screens": ["farmer-upload-report", "partner-reports"] },
    { "id": "feedback", "title": "تغذية راجعة على خدمة", "domain": "data-up", "fields": [ { "name": "request_id", "type": "ref", "required": true }, { "name": "farmer_id", "type": "ref", "required": true }, { "name": "rating", "type": "int", "required": true }, { "name": "outcome", "type": "json", "required": false, "note": "أثر الخدمة: إنتاجية، جودة، تكلفة" }, { "name": "comment", "type": "text", "required": false }, { "name": "date", "type": "date", "required": true } ], "screens": ["farmer-feedback", "partner-analytics"] },
    { "id": "region-dataset", "title": "بيانات المنطقة (من الشركة)", "domain": "data-down", "description": "ما تُدخله الشركة لكل محافظة: توصيات، مواعيد، أسعار، تحذيرات آفات، حالة تربة عامة.", "fields": [ { "name": "provider_id", "type": "ref", "required": true }, { "name": "region_id", "type": "ref", "required": true }, { "name": "product", "type": "string", "required": false, "note": "المحصول المعني إن وُجد" }, { "name": "kind", "type": "enum", "required": true, "note": "recommendation | schedule | alert | price | soil-profile" }, { "name": "payload", "type": "json", "required": true }, { "name": "valid_from", "type": "date", "required": true }, { "name": "valid_to", "type": "date", "required": false } ], "screens": ["partner-region-data", "farmer-insights"] },
    { "id": "insight", "title": "معلومة مخصصة للفلاح", "domain": "data-down", "description": "ناتج مطابقة بيانات المنطقة والخدمة مع محصول الفلاح وتقاريره: توصية شخصية.", "fields": [ { "name": "farmer_id", "type": "ref", "required": true }, { "name": "crop_id", "type": "ref", "required": false }, { "name": "source_dataset_id", "type": "ref", "required": false }, { "name": "source_report_id", "type": "ref", "required": false }, { "name": "title", "type": "string", "required": true }, { "name": "body", "type": "text", "required": true }, { "name": "read_at", "type": "datetime", "required": false } ], "screens": ["farmer-insights"] },
    { "id": "aggregate", "title": "إحصاء مجمّع للشركة", "domain": "analytics", "description": "لا هوية فردية: أصناف ومساحات وتفاعل وتقييم بحسب المحافظة والموسم.", "fields": [ { "name": "provider_id", "type": "ref", "required": true }, { "name": "region_id", "type": "ref", "required": true }, { "name": "period", "type": "string", "required": true }, { "name": "metrics", "type": "json", "required": true }, { "name": "min_group_size", "type": "int", "required": true, "note": "لا يُعرض تجميع دون حد أدنى من الفلاحين" } ], "screens": ["partner-analytics"] },
    { "id": "data-agreement", "title": "اتفاقية بيانات", "domain": "governance", "description": "ما يحق للشركة رؤيته مقابل ما تقدمه، وحدود التجميع، ومدة الاتفاق.", "fields": [ { "name": "provider_id", "type": "ref", "required": true }, { "name": "scope", "type": "json", "required": true }, { "name": "min_group_size", "type": "int", "required": true }, { "name": "starts", "type": "date", "required": true }, { "name": "ends", "type": "date", "required": false } ], "screens": ["admin-agreements"] }
  ],
  "screens": [
    { "id": "farmer-services", "title": "الخدمات المساندة (داخل تطبيق ثمرة)", "role": "farmer", "status": "planned", "fields": ["category", "region"], "actions": [ { "label": "فتح خدمة", "to": "farmer-service-detail" }, { "label": "معلوماتي المخصصة", "to": "farmer-insights" }, { "label": "رفع تحليل", "to": "farmer-upload-report" } ] },
    { "id": "farmer-service-detail", "title": "تفاصيل خدمة وعروضها", "role": "farmer", "status": "planned", "fields": ["title", "description", "offerings", "pricing"], "actions": [ { "label": "طلب", "to": "farmer-service-request", "api": "requests.create" } ] },
    { "id": "farmer-service-request", "title": "طلب الخدمة", "role": "farmer", "status": "planned", "fields": ["farm_id", "crop_id", "input"], "actions": [ { "label": "إرسال", "to": "farmer-service-track", "api": "requests.create" } ] },
    { "id": "farmer-service-track", "title": "متابعة طلباتي", "role": "farmer", "status": "planned", "fields": ["status"], "actions": [ { "label": "تقييم", "to": "farmer-feedback" } ] },
    { "id": "farmer-feedback", "title": "تقييم الخدمة بعد التجربة", "role": "farmer", "status": "planned", "fields": ["rating", "outcome", "comment"], "actions": [ { "label": "إرسال", "api": "feedback.create" } ] },
    { "id": "farmer-upload-report", "title": "رفع تحليل تربة/مياه/منتج", "role": "farmer", "status": "planned", "fields": ["kind", "file", "farm_id", "crop_id", "shared_with"], "actions": [ { "label": "رفع", "to": "farmer-insights", "api": "reports.create" } ] },
    { "id": "farmer-insights", "title": "معلوماتي المخصصة (محصولي ومنطقتي)", "role": "farmer", "status": "planned", "fields": ["insights", "region_alerts", "schedules"], "actions": [ { "label": "فتح الخدمة المصدر", "to": "farmer-service-detail" } ] },
    { "id": "partner-onboarding", "title": "تسجيل الشركة الشريكة", "role": "partner", "status": "planned", "fields": ["name", "kind", "license", "regions"], "actions": [ { "label": "إرسال للاعتماد", "to": "partner-home", "api": "providers.create" } ] },
    { "id": "partner-home", "title": "لوحة الشركة (الرئيسية)", "role": "partner", "status": "planned", "fields": ["kpis"], "actions": [ { "label": "خدماتي", "to": "partner-services" }, { "label": "بيانات المحافظات", "to": "partner-region-data" }, { "label": "الطلبات", "to": "partner-requests" }, { "label": "التحليلات", "to": "partner-analytics" } ] },
    { "id": "partner-services", "title": "إدارة الخدمات", "role": "partner", "status": "planned", "fields": ["title", "category", "input_schema", "output_schema", "regions"], "actions": [ { "label": "حفظ", "api": "services.upsert" }, { "label": "العروض", "to": "partner-offerings" } ] },
    { "id": "partner-offerings", "title": "العروض والمنتجات", "role": "partner", "status": "planned", "fields": ["name", "spec", "price", "availability", "suitable_products"], "actions": [ { "label": "حفظ", "api": "offerings.upsert" } ] },
    { "id": "partner-region-data", "title": "إدخال بيانات المحافظات", "role": "partner", "status": "planned", "fields": ["region_id", "product", "kind", "payload", "valid_from", "valid_to"], "actions": [ { "label": "نشر", "api": "datasets.upsert" } ] },
    { "id": "partner-requests", "title": "الطلبات الواردة", "role": "partner", "status": "planned", "fields": ["status"], "actions": [ { "label": "تحديث الحالة", "api": "requests.update" } ] },
    { "id": "partner-reports", "title": "التحاليل المشاركة معنا", "role": "partner", "status": "planned", "fields": ["kind", "values"], "actions": [ { "label": "إرسال نتيجة/توصية", "api": "insights.create" } ] },
    { "id": "partner-analytics", "title": "التحليلات المجمّعة", "role": "partner", "status": "planned", "fields": ["region", "period", "metrics"], "actions": [] },
    { "id": "partner-users", "title": "مستخدمو الشركة", "role": "partner", "status": "planned", "fields": ["name", "role"], "actions": [] },
    { "id": "admin-agreements", "title": "اتفاقيات البيانات والاعتماد", "role": "admin", "status": "planned", "fields": ["provider_id", "scope", "min_group_size"], "actions": [ { "label": "اعتماد الشركة", "api": "providers.approve" } ] }
  ],
  "apis": [
    { "id": "providers.create", "method": "POST", "path": "/providers", "entity": "provider", "screens": ["partner-onboarding"] },
    { "id": "providers.approve", "method": "POST", "path": "/providers/{id}/approve", "entity": "provider", "screens": ["admin-agreements"] },
    { "id": "services.upsert", "method": "PUT", "path": "/services/{id}", "entity": "service", "screens": ["partner-services"] },
    { "id": "offerings.upsert", "method": "PUT", "path": "/offerings/{id}", "entity": "offering", "screens": ["partner-offerings"] },
    { "id": "requests.create", "method": "POST", "path": "/service-requests", "entity": "service-request", "screens": ["farmer-service-request"] },
    { "id": "requests.update", "method": "PATCH", "path": "/service-requests/{id}", "entity": "service-request", "screens": ["partner-requests"] },
    { "id": "reports.create", "method": "POST", "path": "/farm-reports", "entity": "farm-report", "screens": ["farmer-upload-report"], "description": "يرفع الملف ويستخرج القيم إن أمكن ويطبّق موافقات المشاركة." },
    { "id": "feedback.create", "method": "POST", "path": "/feedback", "entity": "feedback", "screens": ["farmer-feedback"] },
    { "id": "datasets.upsert", "method": "PUT", "path": "/region-datasets/{id}", "entity": "region-dataset", "screens": ["partner-region-data"], "description": "ينتج عنه توليد insights للفلاحين المطابقين (محصول + منطقة)." },
    { "id": "insights.create", "method": "POST", "path": "/insights", "entity": "insight", "screens": ["partner-reports"] },
    { "id": "aggregates.query", "method": "GET", "path": "/aggregates", "entity": "aggregate", "screens": ["partner-analytics"], "description": "لا يعيد مجموعات أصغر من min_group_size." },
    { "id": "core.sync", "method": "GET", "path": "/core/{farmers|farms|crops}", "entity": "core-farmer", "screens": [], "description": "عقد القراءة من نواة ثمرة بموافقة الفلاح." }
  ],
